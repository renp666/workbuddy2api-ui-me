# Normalize line endings on commit so CRLF working copies (core.autocrlf=true on Windows)
# cannot leak bare LF into tracked files, and so patches apply predictably across platforms.
* text=auto eol=lf

*.go   text eol=lf
*.js   text eol=lf
*.cjs  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
Dockerfile* text eol=lf

*.png  binary
*.jpg  binary
*.ico  binary
*.zip  binary
