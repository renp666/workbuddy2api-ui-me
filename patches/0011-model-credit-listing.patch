+func TestFetchModelsParsesCredits(t *testing.T) {
+	c := testClient(func(r *http.Request) (*http.Response, error) {
+		return jsonResp(200, `{"code":0,"data":{"models":[
+			{"id":"hy3","name":"HY3","maxInputTokens":131072,"maxOutputTokens":8192,"credits":"x0.00 credits"},
+			{"id":"glm-5.3","name":"GLM","maxInputTokens":131072,"maxOutputTokens":8192,"credits":"x0.79"},
+			{"id":"no-credits","name":"NC","maxInputTokens":131072,"maxOutputTokens":8192}
+		],"agents":[{"name":"cli","models":["hy3","glm-5.3","no-credits"]}]}}`), nil
+	})
+	infos, err := c.FetchModels(authStub())
+	if err != nil {
+		t.Fatalf("fetch models: %v", err)
+	}
+	got := make(map[string]string, len(infos))
+	for _, mi := range infos {
+		got[mi.ID] = mi.Credits
+	}
