+		t.Errorf("hy3 Credits=%q want 'x0.00 credits'", got["hy3"])
+	}
+	if got["glm-5.3"] != "x0.79" {
+		t.Errorf("glm-5.3 Credits=%q want x0.79", got["glm-5.3"])
+	}
+	if got["no-credits"] != "" {
+		t.Errorf("no-credits Credits=%q want empty", got["no-credits"])
+	}
