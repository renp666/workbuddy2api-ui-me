+// creditsSnapshot 返回指定 realm 的积分消耗规则缓存副本；该域无探测 → nil（前端标「未知」）。
+func (c *Client) creditsSnapshot(realm string) map[string]string {
+	c.effortsMu.RLock()
+	defer c.effortsMu.RUnlock()
+	bucket, ok := c.credits[realmKey(realm)]
+	if !ok || len(bucket) == 0 {
+		return nil
+	}
+	cp := make(map[string]string, len(bucket))
+	for k, v := range bucket {
+		cp[k] = v
+	}
+	return cp
+}
+
+// storeCredits 按 realm 写入积分消耗规则缓存桶（原始串），并发安全。
+// 供 CN FetchModels 与 global 探测共用：拉取到的模型倍率落桶后，/v1/models 才能透出。
+// 空桶时删除该 realm 桶（等价「该域无倍率数据」）；调用方负责在「无新数据」时跳过写
+// （避免某探测无倍率数据清掉既有桶，见 FetchModels 尾部与 global_models.go）。
+func (c *Client) storeCredits(realm string, credits map[string]string) {
+	c.effortsMu.Lock()
+	defer c.effortsMu.Unlock()
+	if c.credits == nil {
+		c.credits = make(map[string]map[string]string)
+	}
+	k := realmKey(realm)
+	if len(credits) == 0 {
+		delete(c.credits, k)
+		return
+	}
+	c.credits[k] = credits
+}
