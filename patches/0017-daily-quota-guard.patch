diff --git a/internal/server/quota_guard_test.go b/internal/server/quota_guard_test.go
new file mode 100644
index 0000000..5fee22e
--- /dev/null
+++ b/internal/server/quota_guard_test.go
@@ -0,0 +1,63 @@
+// 每日限额护栏末端语义（补丁 0017）：全达额 429+Retry-After，其余不可用 503。
+package server
+
+import (
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"workbuddy2api/internal/auth"
+	"workbuddy2api/internal/pool"
+	"workbuddy2api/internal/upstream"
+)
+
+type fakeQuota struct{ exhausted bool }
+
+func (f fakeQuota) RealmExhausted(realm string) bool { return f.exhausted }
+
+// TestQuotaExhaustedReturns429 空池（无号可达末端）+ 全达额 → 429 daily_quota_exhausted
+// 且带 Retry-After；guard false 时维持 503 no_healthy_account。
+func TestQuotaExhaustedReturns429(t *testing.T) {
+	p := pool.New("")
+	req := func(h *Handler) *httptest.ResponseRecorder {
+		r := httptest.NewRequest("POST", "/v1/chat/completions",
+			strings.NewReader(`{"model":"hy4-preview","messages":[{"role":"user","content":"hi"}]}`))
+		r.Header.Set("Authorization", "Bearer secret")
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, r)
+		return rec
+	}
+
+	h := NewHandler(Config{Pool: p, Upstream: upstream.New(), APIKey: "secret", Quota: fakeQuota{exhausted: true}})
+	rec := req(h)
+	if rec.Code != 429 {
+		t.Fatalf("全达额应 429，得到 %d body=%s", rec.Code, rec.Body.String())
+	}
+	if !strings.Contains(rec.Body.String(), "daily_quota_exhausted") {
+		t.Fatalf("错误码应为 daily_quota_exhausted：%s", rec.Body.String())
+	}
+	if rec.Header().Get("Retry-After") == "" {
+		t.Fatal("429 必须带 Retry-After（指向本地 0 点）")
+	}
+
+	h2 := NewHandler(Config{Pool: p, Upstream: upstream.New(), APIKey: "secret", Quota: fakeQuota{exhausted: false}})
+	rec2 := req(h2)
+	if rec2.Code != 503 || !strings.Contains(rec2.Body.String(), "no_healthy_account") {
+		t.Fatalf("guard=false 应维持 503 no_healthy_account，得到 %d %s", rec2.Code, rec2.Body.String())
+	}
+}
+
+// TestQuotaGuardNilKeeps503 未注入护栏（源码模式/未启用）时零回归。
+func TestQuotaGuardNilKeeps503(t *testing.T) {
+	p := pool.New("")
+	p.Add(&auth.Auth{UID: "u1", AccessToken: "at", ExpiresAt: 9999999999})
+	h := NewHandler(Config{Pool: p, Upstream: upstream.New(), APIKey: "secret"})
+	r := httptest.NewRequest("POST", "/v1/chat/completions",
+		strings.NewReader(`{"model":"hy4-preview","messages":[{"role":"user","content":"hi"}]}`))
+	r.Header.Set("Authorization", "Bearer secret")
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, r)
+	if rec.Code == 429 {
+		t.Fatalf("未接线护栏时不得返回 429：%d", rec.Code)
+	}
+}
