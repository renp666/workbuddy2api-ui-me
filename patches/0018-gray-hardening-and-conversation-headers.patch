+	got := TurnKey([]byte(withImg))
+	if !strings.HasPrefix(got, "u0:看图") || !strings.Contains(got, "[image_url:") {
+		t.Errorf("图文轮键应保留文本前缀并带图片摘要标记，got %q", got)
+	}
+	if again := TurnKey([]byte(withImg)); again != got {
+		t.Errorf("同 body 两轮应同键：%q vs %q", got, again)
+	}
+	imgOnly := `{"messages":[{"role":"user","content":[{"type":"image_url","image_url":{"url":"x"}}]}]}`
+	if only := TurnKey([]byte(imgOnly)); !strings.HasPrefix(only, "u0:[image_url:") {
+		t.Errorf("纯图片轮应建键（不再返回空串），got %q", only)
+	}
+	// 空字符串文本 part 全空 → 无可签名内容 → 仍空串（不伪造）。
+	blank := `{"messages":[{"role":"user","content":[{"type":"text","text":""}]}]}`
+	if got := TurnKey([]byte(blank)); got != "" {
+		t.Errorf("全空文本 part 应视为无内容，got %q", got)
+	}
+}
